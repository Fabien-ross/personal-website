fabienrosset.com {
    handle_path /media/* {
        root * /media
        file_server
    }

    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle /api/* {
        reverse_proxy server:8000
    }

    handle /admin/* {
        reverse_proxy server:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}